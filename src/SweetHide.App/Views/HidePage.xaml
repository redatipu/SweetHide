<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SweetHide.App.Views.HidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SweetHide.App.Controls"
    xmlns:local="using:SweetHide.App"
    xmlns:p="using:SweetHide.Presentation"
    xmlns:vm="using:SweetHide.Presentation.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Invoked="OnPasteAccelerator" Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <ScrollViewer>
        <Grid
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            ColumnSpacing="16"
            RowSpacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SecondColumn.Width" Value="*" />
                            <Setter Target="RightColumn.(Grid.Column)" Value="1" />
                            <Setter Target="RightColumn.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SecondColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.ColumnSpan="2"
                Style="{StaticResource PageHeaderStyle}"
                Text="{x:Bind p:Strings.HideHeader}" />

            <!-- Left: cover image and capacity -->
            <StackPanel Grid.Row="1" Spacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind p:Strings.CoverSection}" />
                        <controls:ImageDropZone
                            BrowseCommand="{x:Bind ViewModel.BrowseCoverCommand}"
                            DropCommand="{x:Bind ViewModel.LoadDroppedCoverCommand}"
                            Image="{x:Bind ViewModel.Cover, Mode=OneWay}"
                            ImageInfo="{x:Bind ViewModel.CoverInfo, Mode=OneWay}"
                            PasteCommand="{x:Bind ViewModel.PasteCoverCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind p:Strings.CapacitySection}" />
                        <ProgressBar
                            IsIndeterminate="{x:Bind ViewModel.IsMeasuring, Mode=OneWay}"
                            Maximum="100"
                            ShowError="{x:Bind ViewModel.IsCapacityOver, Mode=OneWay}"
                            ShowPaused="{x:Bind ViewModel.IsCapacityWarning, Mode=OneWay}"
                            Value="{x:Bind ViewModel.UsagePercent, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CapacityText, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CapacityHint, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasCapacityHint, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <InfoBar
                    IsClosable="True"
                    IsOpen="True"
                    Message="{x:Bind p:Strings.SendAsFileMessage}"
                    Severity="Informational"
                    Title="{x:Bind p:Strings.SendAsFileTitle}" />
            </StackPanel>

            <!-- Right (or below, when narrow): what to hide, password, action -->
            <StackPanel
                x:Name="RightColumn"
                Grid.Row="2"
                Spacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind p:Strings.MessageSection}" />
                        <TextBox
                            MinHeight="120"
                            MaxHeight="280"
                            AcceptsReturn="True"
                            AutomationProperties.Name="{x:Bind p:Strings.MessageSection}"
                            PlaceholderText="{x:Bind p:Strings.MessagePlaceholder}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    AllowDrop="True"
                    DragOver="OnAttachmentsDragOver"
                    Drop="OnAttachmentsDrop"
                    Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind p:Strings.AttachmentsSection}" />
                            <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddFilesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE723;" />
                                    <TextBlock Text="{x:Bind p:Strings.AddFiles}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind p:Strings.NoAttachments}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoAttachments, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Attachments}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AttachmentViewModel">
                                    <Grid Padding="0,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" Glyph="&#xE7C3;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SizeText}" />
                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="{x:Bind p:Strings.RemoveAttachment}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnRemoveAttachmentClick"
                                            ToolTipService.ToolTip="{x:Bind p:Strings.RemoveAttachment}">
                                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <PasswordBox
                            Header="{x:Bind p:Strings.PasswordSection}"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                            PlaceholderText="{x:Bind p:Strings.PasswordPlaceholder}" />
                        <ProgressBar
                            Maximum="4"
                            Visibility="{x:Bind ViewModel.ShowStrength, Mode=OneWay}"
                            Value="{x:Bind ViewModel.StrengthLevel, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StrengthText, Mode=OneWay}" />
                        <PasswordBox
                            Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}"
                            PlaceholderText="{x:Bind p:Strings.ConfirmPasswordPlaceholder}"
                            AutomationProperties.Name="{x:Bind p:Strings.ConfirmPasswordPlaceholder}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind p:Strings.PasswordMismatch}"
                            Visibility="{x:Bind ViewModel.ShowPasswordMismatch, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind p:Strings.PasswordHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{x:Bind p:Strings.AdvancedSection}">
                    <RadioButtons
                        Header="{x:Bind p:Strings.BitsLabel}"
                        ItemsSource="{x:Bind ViewModel.BitsDescriptions}"
                        SelectedIndex="{x:Bind ViewModel.BitsIndex, Mode=TwoWay}" />
                </Expander>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{x:Bind ViewModel.HideCommand}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72E;" />
                            <TextBlock Text="{x:Bind p:Strings.HideButton}" />
                        </StackPanel>
                    </Button>
                    <ProgressRing
                        Width="24"
                        Height="24"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.StatusIsOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Severity="{x:Bind local:Converters.Severity(ViewModel.StatusSeverity), Mode=OneWay}"
                    Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <HyperlinkButton
                            Command="{x:Bind ViewModel.ShowInFolderCommand}"
                            Content="{x:Bind p:Strings.ShowInFolder}"
                            Visibility="{x:Bind ViewModel.HasStatusAction, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
