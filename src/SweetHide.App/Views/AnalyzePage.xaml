<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SweetHide.App.Views.AnalyzePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SweetHide.App.Controls"
    xmlns:local="using:SweetHide.App"
    xmlns:p="using:SweetHide.Presentation"
    xmlns:vm="using:SweetHide.Presentation.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Invoked="OnPasteAccelerator" Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">
            <TextBlock Style="{StaticResource PageHeaderStyle}" Text="{x:Bind p:Strings.AnalyzeHeader}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind p:Strings.AnalyzeIntro}"
                TextWrapping="Wrap" />

            <Border Style="{StaticResource CardStyle}">
                <controls:ImageDropZone
                    BrowseCommand="{x:Bind ViewModel.BrowseImageCommand}"
                    DropCommand="{x:Bind ViewModel.LoadDroppedImageCommand}"
                    Image="{x:Bind ViewModel.Image, Mode=OneWay}"
                    ImageInfo="{x:Bind ViewModel.ImageInfo, Mode=OneWay}"
                    PasteCommand="{x:Bind ViewModel.PasteImageCommand}" />
            </Border>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.StatusIsOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind local:Converters.Severity(ViewModel.StatusSeverity), Mode=OneWay}"
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind p:Strings.ColumnChannel}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind p:Strings.ColumnOnes}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind p:Strings.ColumnChiSquare}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind p:Strings.ColumnProbability}" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelRow">
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Channel}" />
                                    <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{x:Bind OnesRatio}" />
                                    <TextBlock Grid.Column="2" FontFamily="Consolas" Text="{x:Bind ChiSquare}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontFamily="Consolas" Text="{x:Bind Probability}" />
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            Visibility="{x:Bind LooksEmbedded}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind p:Strings.AnalyzeExplanation}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            Header="{x:Bind p:Strings.BitPlaneLabel}"
                            ItemsSource="{x:Bind ViewModel.BitPlanes}"
                            SelectedIndex="{x:Bind ViewModel.BitPlane, Mode=TwoWay}" />
                        <TextBlock
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,6"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind p:Strings.BitPlaneHint}" />
                    </StackPanel>
                    <Image x:Name="BitPlaneImage" MaxHeight="480" Stretch="Uniform" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
