<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SweetHide.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:SweetHide.Presentation"
    xmlns:vm="using:SweetHide.Presentation.ViewModels">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="16">
            <TextBlock Style="{StaticResource PageHeaderStyle}" Text="{x:Bind p:Strings.SettingsHeader}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <RadioButtons
                        Header="{x:Bind p:Strings.LanguageLabel}"
                        ItemsSource="{x:Bind vm:SettingsViewModel.LanguageOptions}"
                        SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.ShowRestartHint, Mode=OneWay}"
                        Message="{x:Bind p:Strings.LanguageRestart}"
                        Severity="Informational" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <RadioButtons
                    Header="{x:Bind p:Strings.ThemeLabel}"
                    ItemsSource="{x:Bind vm:SettingsViewModel.ThemeOptions}"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{x:Bind p:Strings.AboutLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Width="48" Height="48" Source="ms-appx:///Assets/AppIcon.png" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind p:Strings.AppTitle}" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind vm:SettingsViewModel.VersionText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind p:Strings.AboutText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
