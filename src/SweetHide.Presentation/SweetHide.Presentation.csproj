<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SweetHide.Presentation</RootNamespace>
    <Description>View models and UI text for the SweetHide desktop app. UI-framework independent so it can be tested anywhere.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SweetHide.Core\SweetHide.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SweetHide.Presentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Words\*.txt" LogicalName="SweetHide.Words.%(Filename).txt" />
  </ItemGroup>

</Project>
