<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SweetHide.Core</RootNamespace>
    <Description>Steganography engine: hides encrypted text and files in the low bits of lossless images.</Description>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- Lets the CLI run on Linux homelab servers (x64/arm64) without system libs. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="NSec.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SweetHide.Core.Tests" />
    <InternalsVisibleTo Include="SweetHide.Cli.Tests" />
    <InternalsVisibleTo Include="SweetHide.Presentation.Tests" />
  </ItemGroup>

</Project>
