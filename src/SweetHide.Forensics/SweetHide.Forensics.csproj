<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SweetHide.Forensics</RootNamespace>
    <Description>Read-only forensics for finding data hidden in images and audio by other tools (CTF-style "stego finder").</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core package only: decoding works on raw luminance, no System.Drawing or SkiaSharp bindings needed. -->
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SweetHide.Core\SweetHide.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SweetHide.Forensics.Tests" />
  </ItemGroup>

</Project>
