<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sweethide</AssemblyName>
    <RootNamespace>SweetHide.Cli</RootNamespace>
    <Description>Command-line tool to hide and reveal encrypted text and files in images.</Description>
  </PropertyGroup>

  <!-- Self-contained single-file builds: dotnet publish -c Release -r win-x64 (or linux-x64 / linux-arm64) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Ship just the executable: no .pdb/.xml from referenced projects. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <!-- SkiaSharp's Windows package ships a ~90 MB native .pdb; users don't need it. -->
  <Target Name="DropDebugSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- Already transitive via Core; referenced here only to locate their notice files (build/Licenses.targets). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" GeneratePathProperty="true" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" GeneratePathProperty="true" />
  </ItemGroup>

  <Import Project="..\..\build\Licenses.targets" />

  <ItemGroup>
    <ProjectReference Include="..\SweetHide.Core\SweetHide.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SweetHide.Cli.Tests" />
  </ItemGroup>

</Project>
